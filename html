	<section class="fsElement fsContainer button-panel-3" id="fsEl_5373" data-use-new="true" >

				<header>
				<h2 class="fsElementTitle" id="fsElementTitle_5373">Howell High School's Programs & Supports</h2>
			<div class="fsElementHeaderContent">
				<p>Learn more about Howell&#39;s unique programs.</p>

			</div>
	</header>
	<div class="fsElementContent" >
			<section class="fsElement fsResourceElement fsSingleItem" id="fsEl_5374" data-use-new="true" data-source-element-id="5374" data-source-page-id="958" data-display-items="collections_and_resources" >

				<header>
				<h2 class="fsElementTitle" id="fsElementTitle_5374">IB World School</h2>
			<div class="fsElementHeaderContent">
				<p>The IB Diploma Programme is an academically challenging and balanced programme of education, with final examinations, that prepares students aged 16 to 19 for success at university and in life beyond.&nbsp;</p>

<p><a class="button-arrow-on-dark" href="https://sites.google.com/frhsd.com/frhsd-ib/home">Find Out More</a></p>

			</div>
	</header>
	<div class="fsElementContent" >
		<article class="fsResource fsResourceTypeImage"><figure><a class="fsResourceLink" data-permitted-user="true" data-preview="false" data-resource-title="ib-world-school-logo-1-colour.png" data-resource-type="Image" href="https://sites.google.com/frhsd.com/frhsd-ib/home"><picture><img alt="" data-aspect-ratio="0.9817813765182186" data-image-sizes="[{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_1/v1718640709/frhsdcom/y9ke0zzgltqfik7ajfsy/ib-world-school-logo-1-colour.png%22,%22width%22:256},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto/v1718640709/frhsdcom/y9ke0zzgltqfik7ajfsy/ib-world-school-logo-1-colour.png%22,%22width%22:494}]" data-permitted-user="true" data-resource-title="ib-world-school-logo-1-colour.png" data-resource-uuid="59cb382c-2c90-4b99-a273-14a985f59d23"></picture></a></figure></article>
	</div>


	</section>
	
	<section class="fsElement fsResourceElement fsSingleItem" id="fsEl_5375" data-use-new="true" data-source-element-id="5375" data-source-page-id="958" data-display-items="collections_and_resources" >

				<header>
				<h2 class="fsElementTitle" id="fsElementTitle_5375">Fine and Performing Arts Program</h2>
			<div class="fsElementHeaderContent">
				<p dir="ltr" role="presentation">Since 1984, the Fine and Performing Arts Magnet Program has provided conservatory-type training to young artists who want to combine a college preparatory schedule with advanced arts training in a traditional high school setting.&nbsp;</p>

<p><a class="button-arrow-on-dark" href="https://sites.google.com/frhsd.com/fpacopenhouse/home?authuser=0">Find Out More</a></p>

			</div>
	</header>
	<div class="fsElementContent" >
		<article class="fsResource fsResourceTypeImage"><figure><a class="fsResourceLink" data-permitted-user="true" data-preview="false" data-resource-title="20240606_203904.jpg" data-resource-type="Image" href="https://sites.google.com/frhsd.com/fpacopenhouse/home?authuser=0"><picture><img alt="" data-aspect-ratio="0.75" data-image-sizes="[{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_1/v1718640771/frhsdcom/fmg1g2fyjdelwujvu92k/20240606_203904.jpg%22,%22width%22:256},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_2/v1718640771/frhsdcom/fmg1g2fyjdelwujvu92k/20240606_203904.jpg%22,%22width%22:512},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_3/v1718640771/frhsdcom/fmg1g2fyjdelwujvu92k/20240606_203904.jpg%22,%22width%22:800},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_4/v1718640771/frhsdcom/fmg1g2fyjdelwujvu92k/20240606_203904.jpg%22,%22width%22:1200},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_5/v1718640771/frhsdcom/fmg1g2fyjdelwujvu92k/20240606_203904.jpg%22,%22width%22:1600},{%22url%22:%22https://resources.finalsite.net/images/f_auto,q_auto,t_image_size_6/v1718640771/frhsdcom/fmg1g2fyjdelwujvu92k/20240606_203904.jpg%22,%22width%22:2200}]" data-permitted-user="true" data-resource-title="20240606_203904.jpg" data-resource-uuid="59f9535f-d0e0-49a7-ab80-c4c38228ff66"></picture></a></figure></article>
